# Supabase — Settings > API no dashboard do projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: nunca no client. Só em lib/supabase/admin.ts e rotas server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — entra na Fase 3 (checkout)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Chave secreta do webhook (Suas integrações > sua aplicação > Webhooks > "Chave secreta"). Opcional mas recomendado.
MERCADOPAGO_WEBHOOK_SECRET=

# Melhor Envio — entra na Fase 3 (frete)
MELHOR_ENVIO_TOKEN=
# CEP de origem dos envios (endereço da loja). Sandbox por padrão.
MELHOR_ENVIO_ORIGIN_CEP=
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
# App OAuth do Melhor Envio (Configurações > Conectar usa estes dois)
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=

# Vercel Cron: a Vercel manda "Authorization: Bearer $CRON_SECRET" para /api/cron/*.
# Sem ela o cron semanal que renova o token do Melhor Envio não roda.
CRON_SECRET=

# Resend — e-mails transacionais (Fase 8). resend.com > API Keys.
RESEND_API_KEY=
# Precisa ser um domínio verificado no Resend; até verificar, use o padrão de teste.
RESEND_FROM_EMAIL="Salmar Brindes <onboarding@resend.dev>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
